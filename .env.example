# Copy to .env and fill in:  cp .env.example .env     (never commit .env)
# Required before BOTH ways of running: `docker compose up` refuses to start without .env.
# Empty values are treated as "not set".
#
# Two ways to run, two sections below:
#   1. LOCAL RUN  - app/worker on your machine (uv run ...), Postgres/Redis on localhost.
#   2. DOCKER     - `docker compose up`; compose builds the URLs from the POSTGRES_* values.
# Everything outside those two sections is shared by both.

# =============================================================================================
# Shared: Telegram, LLM, optional app settings
# =============================================================================================

# --- Telegram (userbot account) -----------------------------------------------------------
# From https://my.telegram.org -> API development tools. Belongs to the SECOND (userbot) account.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Telegram (control bot) ---------------------------------------------------------------
# Token from @BotFather for the aiogram control-panel bot.
BOT_TOKEN=
# Numeric Telegram user id of the owner (the MAIN account); only this user may control the bot.
OWNER_TELEGRAM_ID=

# --- LLM ------------------------------------------------------------------------------------
DEEPSEEK_API_KEY=
# Optional. Default: deepseek-chat
# DEEPSEEK_MODEL=deepseek-chat

# --- Optional app settings ------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR | CRITICAL. Default: INFO
# LOG_LEVEL=INFO
# Levels for noisy libraries, independent of LOG_LEVEL. Default: WARNING for each.
# HTTPX_LOG_LEVEL also covers httpcore (httpx's transport).
# TELETHON_LOG_LEVEL=WARNING
# AIOGRAM_LOG_LEVEL=WARNING
# HTTPX_LOG_LEVEL=WARNING
# IANA timezone name. Default: Europe/Moscow
# TIMEZONE=Europe/Moscow
# Liveness file the app touches for the docker healthcheck. Default: <tmpdir>/cyrano-heartbeat
# HEARTBEAT_PATH=

# =============================================================================================
# 1. LOCAL RUN (outside Docker)
# =============================================================================================
# Used when you run `uv run python -m cyrano` / `uv run arq ...` on the host. Postgres/Redis are
# expected on localhost, e.g. the compose ones published by docker-compose.override.yml
# (`docker compose up -d postgres redis`). Must use the asyncpg driver. The user, password and
# database must match POSTGRES_* in the Docker section.
# Docker IGNORES these four: compose overrides them inside the containers.
DATABASE_URL=postgresql+asyncpg://cyrano:change-me@localhost:5432/cyrano
REDIS_URL=redis://localhost:6379/0
# Where the Telethon session file lives and where downloaded media goes (relative to cwd).
USERBOT_SESSION_PATH=data/session/userbot
MEDIA_DIR=data/media

# =============================================================================================
# 2. DOCKER (docker compose)
# =============================================================================================
# Single source of truth for credentials: initialises the postgres container AND is used by
# compose to build DATABASE_URL for app and worker (host `postgres`; Redis is `redis:6379`).
# The password goes into a URL unescaped, so use only URL-safe characters (letters, digits,
# `-` `.` `_` `~`), e.g. `openssl rand -hex 24`. Change "change-me" before any real deployment.
POSTGRES_USER=cyrano
POSTGRES_PASSWORD=change-me
POSTGRES_DB=cyrano
# Host ports on 127.0.0.1 published by docker-compose.override.yml. Change only if 5432/6379
# are already taken on your machine, and then use the same ports in the local URLs above.
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
