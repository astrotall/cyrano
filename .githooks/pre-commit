#!/bin/sh
set -eu

root=$(cd "$(dirname "$0")/.." && pwd -P)
cd "$root"

echo "pre-commit: running make check"
make check

if [ "${CYRANO_HOOK_SKIP_TESTS:-}" = "1" ]; then
    echo "pre-commit: tests skipped on purpose (CYRANO_HOOK_SKIP_TESTS=1); CI still runs them"
    exit 0
fi

if [ -z "${TEST_DATABASE_URL:-}" ]; then
    echo "pre-commit: TEST_DATABASE_URL is not set in the environment; the tests need a reachable PostgreSQL (see the README, Testing)"
fi

echo "pre-commit: running make test"
make test
